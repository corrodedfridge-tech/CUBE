rules_version = '2';

// CUBE — Firestore security rules.
// Firebase console -> Firestore Database -> Rules -> paste all of this -> Publish.
//
// This file, not the config in index.html, is what protects the database. That config is
// public and always will be: it names the project, it does not unlock it. These rules do.
//
//   - anyone signed in can read the boards
//   - you can write one row per board per window, for yourself, never downward, and only
//     with a number inside believable limits
//   - you can write your own profile but not the two fields that would let you cheat
//   - corrodedfridge@gmail.com can do anything

service cloud.firestore {
  match /databases/{database}/documents {

    function admin() {
      return request.auth != null
          && request.auth.token.email == 'corrodedfridge@gmail.com'
          && request.auth.token.email_verified == true;
    }
    function signedIn() { return request.auth != null; }
    function mine(uid)  { return request.auth != null && request.auth.uid == uid; }
    function notBanned() {
      return !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    // ---------------- players ----------------
    match /users/{uid} {
      allow read:   if mine(uid) || admin();
      allow delete: if admin();

      // You may write your own row, but not the two fields that are about you rather than
      // from you: an admin's parcel, and whether you are banned.
      allow create: if admin() || (
           mine(uid)
        && request.resource.data.uid == uid
        && !('grant'  in request.resource.data)
        && !('banned' in request.resource.data)
        && request.resource.data.get('name', '').size() <= 40
      );
      allow update: if admin() || (
           mine(uid)
        && request.resource.data.uid == uid
        && request.resource.data.get('grant',  {})    == resource.data.get('grant',  {})
        && request.resource.data.get('banned', false) == resource.data.get('banned', false)
        && request.resource.data.get('name', '').size() <= 40
      );
    }

    // ---------------- the boards ----------------
    // A document id is kind__period__uid, so you can only ever occupy one row per board per
    // window, and the rule can tell the row is yours from its name.
    match /scores/{entry} {
      allow read:   if signedIn();
      allow delete: if admin();

      allow create, update: if admin() || (
           signedIn()
        && notBanned()
        && entry == request.resource.data.kind + '__' + request.resource.data.period + '__' + request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.kind in ['score', 'time', 'rb']
        && request.resource.data.v is number
        && request.resource.data.v > 0
        // nobody scores two million, lasts longer than a day, or rebirths five hundred times
        && request.resource.data.v <= (
             request.resource.data.kind == 'score' ? 2000000 :
             request.resource.data.kind == 'time'  ? 86400   : 500)
        && request.resource.data.get('name', '').size() <= 40
        && request.resource.data.get('period', '').size() <= 10
        // a score never goes DOWN. Equal is allowed, because changing the name you appear
        // under rewrites the rows already up there and must not need a better run to do it.
        && (resource == null || request.resource.data.v >= resource.data.v)
      );
    }

    // ---------------- the ban list ----------------
    // Kept out of /users so the score rule can check it in one cheap lookup.
    match /banned/{uid} {
      allow read:  if mine(uid) || admin();
      allow write: if admin();
    }

    // ---------------- the notice, and the parcel for everybody ----------------
    // Readable by anyone, including a guest who has not finished signing in yet.
    match /meta/{doc} {
      allow read:  if true;
      allow write: if admin();
    }

    // anything not named above is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
